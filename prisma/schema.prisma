// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Run `prisma validate` to validate the schema
// Run `prisma format` to format the schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  parent_id   Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_active   Boolean  @default(true)
  products    Product[]

  @@index([parent_id])
  @@index([is_active])
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  cas_no       String?
  category_id  Int?
  description  String?
  details      Json?
  image_url    String?
  features     Json?
  applications Json?
  safety_info  Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_active    Boolean  @default(true)

  category     Category? @relation(fields: [category_id], references: [id])

  @@index([category_id])
  @@index([is_active])
  @@index([cas_no])
}

model NewsCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  // 分类颜色
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  news        News[]

  @@index([slug])
  @@index([is_active])
  @@index([sort_order])
}

model News {
  id            Int      @id @default(autoincrement())
  title         String
  content       String?
  excerpt       String?
  type          String   @default("news")
  publish_date  DateTime @default(now())
  is_published  Boolean  @default(true)
  author        String?
  author_id     Int?
  image_url     String?
  tags          Json?    // 存储标签数组
  read_time     Int?     // 阅读时间（分钟）
  views_count   Int      @default(0) // 浏览次数
  category_id   Int?     // 新闻分类ID
  seo_title     String?  // SEO标题
  seo_description String? // SEO描述
  featured      Boolean  @default(false) // 是否为精选新闻
  sort_order    Int      @default(0) // 排序字段
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  category     NewsCategory? @relation(fields: [category_id], references: [id])

  @@index([publish_date])
  @@index([is_published])
  @@index([type])
  @@index([category_id])
  @@index([featured])
  @@index([sort_order])
}

model Career {
  id                    Int      @id @default(autoincrement())
  position              String
  department            String?
  location              String?
  type                  String   @default("full_time")
  experience_requirement String?
  description           String?
  requirements          Json?    // 存储数组格式的要求
  responsibilities      Json?    // 存储数组格式的职责
  application_deadline  DateTime?
  salary_range          String?  // 薪资范围
  education_requirement String? // 学历要求
  work_environment      String?  // 工作环境描述
  career_benefits       Json?    // 职业福利（数组）
  contact_email         String?  // 联系邮箱
  contact_phone         String?  // 联系电话
  is_active             Boolean  @default(true)
  sort_order            Int      @default(0) // 排序字段
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([is_active])
  @@index([department])
  @@index([position])
  @@index([sort_order])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  password_hash String
  role         String   @default("user")
  first_name   String?
  last_name    String?
  phone        String?
  is_active    Boolean  @default(true)
  last_login   DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([role])
  @@index([is_active])
}

model ContactSubmission {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  company      String?
  message      String
  ip_address   String?
  user_agent   String?
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([is_read])
}

model HeroBanner {
  id           Int      @id @default(autoincrement())
  title        String
  subtitle     String?
  image_url    String
  button_text  String?
  button_url   String?
  is_active    Boolean  @default(true)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([is_active])
  @@index([sort_order])
}