{
  "name": "unice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "CI=true node -r dotenv/config node_modules/.bin/prisma migrate dev --name add-rbac-permission-system",
    "db:generate": "node -r dotenv/config node_modules/.bin/prisma generate",
    "db:studio": "node -r dotenv/config node_modules/.bin/prisma studio",
    "db:seed": "npx tsx -r dotenv/config prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
